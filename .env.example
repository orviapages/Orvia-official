# URL publica del sitio (usada para metadata, OG y sitemap)
NEXT_PUBLIC_SITE_URL=https://orvia.com.ar

# Numero de WhatsApp de ORVIA en formato internacional sin signos (ej: 5492611234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email al que se envian los leads del formulario de contacto (usado por /api/contact)
CONTACT_EMAIL_TO=

# Si se usa Resend (https://resend.com) para enviar el email del formulario
RESEND_API_KEY=

# Supabase — base de datos real: portfolio, servicios, FAQ y leads del formulario.
# Ver supabase/schema.sql para crear las tablas. Sin estas variables, el sitio
# sigue funcionando igual usando los datos estáticos de /data como respaldo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
